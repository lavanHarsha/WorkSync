# ==============================================================================
# WorkSync Backend - Production & Development Environment Variables
# Copy to .env for local development or set in your cloud hosting provider dashboard (Render, Railway, etc.)
# ==============================================================================

# Server & Environment
PORT=5000
NODE_ENV=production
LOG_LEVEL=info
ENABLE_DEMO_MODE=true

# Database & Cache (Free-Tier Providers: MongoDB Atlas M0 + Upstash Redis)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/worksync?retryWrites=true&w=majority
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# Cryptography & Security
# ENCRYPTION_KEY must be exactly 32 bytes (64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_64_character_hex_string_generate_using_crypto

# JWT Secrets (Must be at least 32 characters in production)
JWT_SECRET=replace_with_at_least_32_characters_random_string_for_jwt
JWT_REFRESH_SECRET=replace_with_at_least_32_characters_random_string_for_refresh

# CORS & Domains (No trailing slashes)
# API_PUBLIC_URL: URL of your backend (e.g. https://worksync-api.onrender.com)
API_PUBLIC_URL=https://your-backend.onrender.com
# FRONTEND_URL: URL of your Vercel frontend (e.g. https://worksync.vercel.app)
FRONTEND_URL=https://your-frontend.vercel.app
# CORS_ORIGINS: Comma-separated list of allowed origins
CORS_ORIGINS=https://your-frontend.vercel.app

# Optional Third-Party App Integrations (Can be configured now or later via UI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
