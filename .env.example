# ==============================================================================
# WorkSync Platform - Environment Variables Template
# Copy this file to .env (or backend/.env) and populate the values.
# NEVER commit your actual .env files to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Server & Database Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
MONGODB_URI=mongodb://127.0.0.1:27017/worksync
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# Security & Cryptography (Agent A)
# ------------------------------------------------------------------------------
# Must be exactly 32 bytes (64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-64-hex-characters-for-aes-256-gcm-at-rest-encryption

# JWT Configuration (15min short-lived access token + 7d rotating refresh token)
JWT_SECRET=replace-with-super-secret-jwt-signing-key-for-access-tokens
JWT_REFRESH_SECRET=replace-with-super-secret-jwt-signing-key-for-refresh-tokens

# Allowed CORS origins (comma-separated list, no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# URLs & Public Domains
# ------------------------------------------------------------------------------
API_PUBLIC_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# Integration Credentials & OAuth Settings (Agent C)
# Redirect URI for OAuth: ${API_PUBLIC_URL}/api/apps/<appId>/oauth/callback
# ------------------------------------------------------------------------------
# Google APIs (Gmail send & Google Sheets append)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub App / OAuth (Issues & Repositories)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=

# Notion API (Database Pages)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_TOKEN=

# Development flags
# Set to 'true' in local dev to allow webhook testing against localhost/private IPs
ALLOW_PRIVATE_WEBHOOK_TARGETS=false

# ------------------------------------------------------------------------------
# Monitoring & Telemetry (Optional)
# ------------------------------------------------------------------------------
SENTRY_DSN=
